# Secrets are generated by the deploy scripts on first run and kept in .env files that are never
# committed. This file only lists their names: no real value.

# identity/.env (identity/deploy.sh)
KEYCLOAK_ADMIN_PASSWORD=
PASSWORD_CAMILLE=
PASSWORD_LUKAS=
PASSWORD_OLIVER=
SECRET_OPEN_WEBUI=
SECRET_STUDIO3D=
SECRET_STORAGE=

# storage/.env (storage/deploy.sh)
S3_ROOT_KEY=
S3_ROOT_SECRET=
S3_UPLOAD_SECRET=
S3_LINKS_SECRET=

# Studio token and Redis password ("studio" Kubernetes secret, keys token and redis)
STUDIO_TOKEN=
REDIS_PASSWORD=
