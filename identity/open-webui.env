# Open WebUI signs in through Keycloak (module 7): variables set on its deployment by
# deploy.sh --plug-open-webui, removed by --unplug-open-webui.
# The internal address: Open WebUI reads the OIDC discovery from its pod.
OPENID_PROVIDER_URL=http://keycloak.identity.svc.cluster.local:8080/realms/example-org/.well-known/openid-configuration
OPENID_REDIRECT_URI=http://127.0.0.1:8080/oauth/oidc/callback
OAUTH_CLIENT_ID=open-webui
# OAUTH_CLIENT_SECRET: in the "open-webui-oidc" Kubernetes secret, never in a file
OAUTH_PROVIDER_NAME=Example Organization
OAUTH_SCOPES=openid email profile
# No new account: only people who already have one.
ENABLE_OAUTH_SIGNUP=false
# Links Keycloak to the existing account with the same address: the user keeps their conversations.
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
